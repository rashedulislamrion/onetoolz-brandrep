# Leave blank until a dedicated LOCAL or STAGING Supabase project is ready.
# Do not use production credentials in local development or previews.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Must match the exact origin used in the browser (no trailing slash).
APP_ORIGIN=http://localhost:3000
APP_ENV=local
# Authentication is deliberately disabled until provider settings and rate limits are reviewed.
AUTH_ENABLED=false
# Use nonproduction only for a separate test project; production for production runtime.
# nwgdzzpcbqmfqujycpqk is PRODUCTION and blocked in local/staging/previews.
SUPABASE_ENVIRONMENT=unconfigured

# Woo ingress stays disabled until the prepared migration, worker, and store verification pass.
WOO_INGESTION_ENABLED=false
WOO_STORE_VERIFIED=false
# cu.onetoolz.com is PRODUCTION. Separate approval for real-order data access;
# never enable for routine local tests. This does not approve commissions/payouts.
WOO_PRODUCTION_STORE_ACCESS_APPROVED=false
WOO_STORE_ORIGIN=https://cu.onetoolz.com
# Server-only values: securely inject, never commit or paste in chat.
WOO_WEBHOOK_SECRET=
WOO_INGESTION_SUPABASE_SECRET_KEY=
# Exact approved database origin; no default. Never use production in local tests.
WOO_APPROVED_SUPABASE_URL=
WOO_READ_CONSUMER_KEY=
WOO_READ_CONSUMER_SECRET=
# Separate scheduler credential. No schedule is deployed automatically.
WOO_WORKER_ENABLED=false
WOO_WORKER_SECRET=
WOO_DISCOVERY_ENABLED=false

# Attribution bridge: leave off until BOTH referral migrations pass acceptance
# and a trusted store-side consent/identity adapter is installed. No browser key.
REFERRAL_BRIDGE_ENABLED=false
REFERRAL_BRIDGE_SECRET=
REFERRAL_SUPABASE_SECRET_KEY=
# Exact separately approved database origin. The connected project is production;
# it is allowed only in production runtime, never local/staging/previews.
REFERRAL_APPROVED_SUPABASE_URL=